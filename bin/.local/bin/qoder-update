#!/usr/bin/env bash
#
# qoder-update — one-command updater for the Qoder desktop app on Omarchy/Arch.
#
# Qoder publishes an official Linux .deb but does not maintain an Arch repo.
# This script converts a downloaded Qoder .deb into a proper Arch package
# (preserving the "1:0.1.2" epoch so normal pacman upgrade semantics work) and
# installs it with pacman -U.
#
# The installed package bakes in one required fix: on Linux, Electron's
# safeStorage falls back to "basic_text" unless the Secret Service keyring is
# forced, which makes safeStorage.isEncryptionAvailable() return false so Qoder
# would otherwise show the login page on every launch. The packaged .desktop
# entry therefore passes --password-store=gnome-libsecret.
#
# Usage:
#   qoder-update                          # use newest Qoder*.deb in ~/Downloads
#   qoder-update /path/to/Qoder-x.deb     # use a specific .deb
#
set -euo pipefail

DEB="${1:-}"
BUILD_DIR="$(mktemp -d /tmp/qoder-update.XXXXXX)"
DEBDATA="$BUILD_DIR/debdata"
trap 'rm -rf "$BUILD_DIR"' EXIT

say()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31mError:\033[0m %s\n' "$*" >&2; exit 1; }

command -v debtap >/dev/null 2>&1 || :
command -v makepkg >/dev/null 2>&1 || die "makepkg is required (install 'base-devel')."
command -v pkexec >/dev/null 2>&1 || die "pkexec is required."

if [[ -z "$DEB" ]]; then
  DEB="$(ls -t "$HOME"/Downloads/Qoder*.deb "$HOME"/Downloads/qoder*.deb 2>/dev/null | head -1 || true)"
  [[ -n "$DEB" ]] || die "No .deb found in ~/Downloads. Pass a .deb path as the argument."
fi
[[ -f "$DEB" ]] || die "deb not found: $DEB"
say "Using: $DEB"

# --- Parse package name/version from the deb control -------------------------
mkdir -p "$DEBDATA"
( cd "$BUILD_DIR" && ar x "$DEB" >/dev/null 2>&1 )
[[ -f "$BUILD_DIR/control.tar.xz" ]] || [[ -f "$BUILD_DIR/control.tar.gz" ]] || die "Could not read deb control archive."
( cd "$BUILD_DIR" && tar -xf "$BUILD_DIR"/control.tar.* >/dev/null 2>&1 )
[[ -f "$BUILD_DIR/control" ]] || die "Deb control metadata missing."
version="$(sed -n 's/^Version: //p' "$BUILD_DIR/control" | head -1)"
pkgname="$(sed -n 's/^Package: //p' "$BUILD_DIR/control" | head -1)"
[[ -n "$version" ]] || die "Could not determine deb version."

epoch=0
pkgver="$version"
if [[ "$version" =~ ^([0-9]+):(.+)$ ]]; then
  epoch="${BASH_REMATCH[1]}"
  pkgver="${BASH_REMATCH[2]}"
fi
# trim build/revision suffix used by deb (e.g. "0.1.2-1" -> keep "0.1.2")
pkgver="${pkgver%%-*}"
say "Repackaging ${pkgname} as ${epoch}:${pkgver}"

# --- Extract the deb data -----------------------------------------------------
mkdir -p "$DEBDATA"
( cd "$DEBDATA" && bsdtar -xf "$BUILD_DIR/data.tar.xz" 2>/dev/null || tar -xf "$BUILD_DIR"/data.tar.* -C "$DEBDATA" )
[[ -d "$DEBDATA/opt" ]] || die "deb data extraction failed (expected /opt content)."

# --- Write a PKGBUILD and build an Arch package ------------------------------
# Force the Secret Service keyring so login credentials actually persist.
sed -i 's|^Exec=.*qoder %U|Exec=/opt/Qoder/qoder --password-store=gnome-libsecret %U|' \
    "$DEBDATA/usr/share/applications/qoder.desktop" || true

PKGBUILDDIR="$BUILD_DIR/pkgbuild"
mkdir -p "$PKGBUILDDIR"
cat > "$PKGBUILDDIR/PKGBUILD" <<EOF
# Maintainer: auto-generated by qoder-update
pkgname=$pkgname
epoch=$epoch
pkgver=$pkgver
pkgrel=1
pkgdesc="Qoder - Agent workbench for human and AI software teams"
arch=('x86_64')
url="https://qoder.com"
license=('unknown')
depends=(
  'gtk3' 'libnotify' 'nss' 'libxtst' 'xdg-utils'
  'at-spi2-core' 'util-linux-libs' 'libsecret' 'hicolor-icon-theme'
  'libcups' 'alsa-lib' 'cairo' 'libx11' 'mesa' 'nspr' 'pango'
)
options=('!strip' '!lto' '!emptydirs')
package() {
  cp -a "$DEBDATA/." "\$pkgdir/"
  # login fix already applied to the staging copy above
}
EOF

cd "$PKGBUILDDIR"
makepkg -f >/dev/null 2>&1 || { makepkg -f 2>&1 | tail -20; exit 1; }
pkgfile="$(ls "$PKGBUILDDIR"/*.pkg.tar.zst | head -1)"
[[ -n "$pkgfile" ]] || die "makepkg did not produce a package."
say "Built: $(basename "$pkgfile")"

# --- Install with pacman (elevation via graphical pkexec prompt) -------------
say "Installing… please approve the authentication prompt."
pkexec sh -c "pacman -U --noconfirm '$pkgfile'"

# --- Keep Documents clean: Qoder writes session work under ~/Documents/Qoder ----
# Redirect it to ~/.local/share/qoder so real files stay out of Documents.
mkdir -p "$HOME/.local/share/qoder"
if [[ -L "$HOME/Documents/Qoder" ]]; then
  ln -sfn "$HOME/.local/share/qoder" "$HOME/Documents/Qoder"
elif [[ -d "$HOME/Documents/Qoder" && ! -L "$HOME/Documents/Qoder" ]]; then
  cp -a "$HOME/Documents/Qoder/." "$HOME/.local/share/qoder/" 2>/dev/null
  rm -rf "$HOME/Documents/Qoder"
  ln -s "$HOME/.local/share/qoder" "$HOME/Documents/Qoder"
elif [[ ! -e "$HOME/Documents/Qoder" ]]; then
  ln -s "$HOME/.local/share/qoder" "$HOME/Documents/Qoder"
fi

# --- Ensure the login fix survives: recreate /usr/bin/qoder wrapper ----------
# Launches Qoder with --password-store=gnome-libsecret so Electron's safeStorage
# uses the Secret Service keyring and login credentials actually persist.
cat > /tmp/qoder-wrapper <<'WRAP'
#!/usr/bin/env bash
exec /opt/Qoder/qoder --password-store=gnome-libsecret "$@"
WRAP
chmod +x /tmp/qoder-wrapper
pkexec sh -c 'install -m 0755 /tmp/qoder-wrapper /usr/bin/qoder && rm -f /tmp/qoder-wrapper'

say "Done. Installed $pkgname $epoch:$pkgver-1."
